# Local Hermes agent gateway — the island's single AI backend.
# It must speak the OpenAI-compatible POST /v1/chat/completions protocol
# (the local Hermes gateway does; default http://127.0.0.1:8642).
HERMES_AGENT_URL=http://127.0.0.1:8642

# Gateway bearer token (for the local Hermes gateway this is its API_SERVER_KEY).
HERMES_AGENT_TOKEN=

# Optional model id the gateway reports (defaults to "hermes-agent").
HERMES_AGENT_MODEL=

# Optional local Hermes state directory (session/skill/memory counts for the swarm UI).
HERMES_HOME=

