{
  "name": "hermes-voxel-city",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A shared 3D voxel island powered entirely by a local Hermes agent — vision-reviewed sculpting, a live agent swarm, and multiplayer exploration. No cloud AI keys.",
  "keywords": [
    "voxel",
    "threejs",
    "hermes-agent",
    "local-ai",
    "ai-agents",
    "multiplayer",
    "typescript",
    "vite"
  ],
  "license": "MIT",
  "author": "DevvGwardo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevvGwardo/Hermes-Voxel-City.git"
  },
  "bugs": {
    "url": "https://github.com/DevvGwardo/Hermes-Voxel-City/issues"
  },
  "homepage": "https://github.com/DevvGwardo/Hermes-Voxel-City#readme",
  "scripts": {
    "predev": "[ -d node_modules/.bin ] || bun install || npm install",
    "dev": "tsx server.ts",
    "prebuild": "[ -d node_modules/.bin ] || bun install || npm install",
    "build": "vite build",
    "prelint": "[ -d node_modules/.bin ] || bun install || npm install",
    "lint": "tsc --noEmit",
    "start": "NODE_ENV=production tsx server.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "0.186.0",
    "tsx": "^4.20.3",
    "vite": "^8.3.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
